<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark"
    android:padding="18dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@id/btn_dialog_close"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Add Channel / Playlist"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search YouTube or paste a link to add to a category"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Mode Selector: Search YouTube vs Direct Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tab_search_mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍 Search YouTube"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_accent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_direct_mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔗 Direct Link / ID"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="@null"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- SECTION 1: SEARCH YOUTUBE -->
    <LinearLayout
        android:id="@+id/container_search_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_filter_option_card"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#94A3B8"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/et_dialog_search_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="e.g. Karikku, Malayalam Songs, Comedy..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_search_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Search"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/colorAccent"
                app:cornerRadius="18dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Search Filter Type Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/colorAccent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_channels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Channels"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/bg_badge_outline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_playlists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Playlists"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/bg_badge_outline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Search Progress Loading -->
        <ProgressBar
            android:id="@+id/progress_search"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/colorAccent"
            android:visibility="gone" />

        <!-- Search Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- Selected Result Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_selected_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#10B981"
            app:cardBackgroundColor="#064E3B"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_selected_thumb"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_placeholder_media"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_selected_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_selected_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready to add"
                        android:textSize="11sp"
                        android:textColor="#6EE7B7" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_clear_selection"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    app:tint="#6EE7B7"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- SECTION 2: DIRECT LINK / ID (Visible in Direct Mode) -->
    <LinearLayout
        android:id="@+id/container_direct_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Channel / Playlist Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title / Name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_channel_name"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="e.g. My Favorite Shows / Songs"
            android:textColorHint="#64748B"
            android:inputType="textCapWords"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_filter_option_card" />

        <!-- YouTube Link or Handle or Playlist ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube URL, @handle, Channel ID or Playlist ID"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_channel_url"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="e.g. @handle, PL..., UC..., or youtube.com/..."
            android:textColorHint="#64748B"
            android:inputType="textUri"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_filter_option_card" />
    </LinearLayout>

    <!-- SECTION 3: DESTINATION CATEGORY SELECTOR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/lbl_select_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destination Category"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btn_dialog_new_category"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_dialog_new_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ New Category"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <Spinner
        android:id="@+id/spinner_category"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_filter_option_card" />

    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:indeterminateTint="@color/colorAccent"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_confirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="➕ Add to Category"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/colorAccent"
            app:cornerRadius="22dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

</LinearLayout>
