<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="135dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="135dp"
        android:layout_height="85dp"
        android:clickable="false"
        android:focusable="false"
        app:cardBackgroundColor="?attr/squircleCardBackground"
        app:cardCornerRadius="13dp"
        app:cardElevation="1dp"
        app:strokeColor="?attr/squircleCardStroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/img_news_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder_media" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_news_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:minLines="2"
        android:text="Malayalam News Headline"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_news_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="News Source • Time"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="9.5sp" />

</LinearLayout>
