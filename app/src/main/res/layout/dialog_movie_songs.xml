<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btn_close_songs">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵  Songs &amp; Jukebox"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_songs_movie_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Movie Songs • Tap any track to play"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_songs"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/layout_songs_loading"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progress_songs"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/color_dark_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Finding official songs &amp; jukebox..."
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/text_no_songs"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:text="No songs found directly. Tap below to search YouTube."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Songs List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_songs"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- Search YouTube More Button -->
    <Button
        android:id="@+id/btn_search_youtube_more"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="🔍  SEARCH ALL SONGS ON YOUTUBE"
        android:backgroundTint="#1E293B"
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
