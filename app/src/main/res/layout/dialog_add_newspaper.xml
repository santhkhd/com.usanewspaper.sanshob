<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="22dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btn_dialog_close"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📰 Add Custom Newspaper"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Add any US national, state, or local news website"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="?android:attr/textColorSecondary"
            android:padding="4dp" />
    </RelativeLayout>

    <!-- Newspaper Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Newspaper / Publication Name"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_newspaper_name"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_search_input"
        android:hint="e.g. The Boston Globe, Dallas News..."
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:imeOptions="actionNext"
        android:layout_marginBottom="14dp" />

    <!-- Website URL Input with Live Favicon Preview -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Website or RSS Feed URL"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/img_favicon_preview"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_newspaper"
            app:tint="@color/color_light_primary"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/et_newspaper_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="https://www.bostonglobe.com"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionDone" />

    </LinearLayout>

    <!-- Category Selection Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Select or Create Category"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_create_new_category_inline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="➕ New Category"
            android:textColor="@color/color_light_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Category Spinner Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/spinner_newspaper_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null" />

    </LinearLayout>

    <!-- Auto-open Category Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/color_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Category will open automatically after adding"
            android:textColor="@color/color_emerald"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_newspaper"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:text="Cancel"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_add_and_open_newspaper"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_accent"
            android:text="➕ Add &amp; Open Category"
            android:textColor="@color/color_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

    </LinearLayout>

</LinearLayout>
