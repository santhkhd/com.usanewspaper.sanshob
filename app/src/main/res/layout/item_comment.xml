<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_comment_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Commenter Initial Avatar -->
    <TextView
        android:id="@+id/text_avatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_icon_circle"
        android:gravity="center"
        android:text="R"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Name and Timestamp Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_commenter_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/text_comment_time"
                android:text="Reader Name"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Just now"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </RelativeLayout>

        <!-- Clear High-Contrast Comment Body Text -->
        <TextView
            android:id="@+id/text_comment_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reader opinion and comment."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</LinearLayout>
