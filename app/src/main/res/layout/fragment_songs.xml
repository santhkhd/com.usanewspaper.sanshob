<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top App Bar & Search Header Container -->
    <LinearLayout
        android:id="@+id/layout_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/categoryCardBackground"
        android:elevation="3dp"
        android:paddingBottom="10dp">

        <!-- Toolbar Row (Properly aligned with no overlapping) -->
        <RelativeLayout
            android:id="@+id/toolbar_songs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?android:attr/textColorPrimary"
                android:contentDescription="Back" />

            <!-- Title & Subtitle Column -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btn_back"
                android:layout_toStartOf="@+id/layout_toolbar_right"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_songs_main_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Malayalam Songs"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_songs_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25,600+ Songs &amp; Lyrics Archive"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Right Controls: Sort Button & Count Badge -->
            <LinearLayout
                android:id="@+id/layout_toolbar_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Sort Button -->
                <LinearLayout
                    android:id="@+id/btn_toolbar_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_sort_year"
                        app:tint="?android:attr/textColorPrimary"
                        android:contentDescription="Sort" />

                    <TextView
                        android:id="@+id/tv_toolbar_sort_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Sort"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Total Count Badge -->
                <TextView
                    android:id="@+id/tv_total_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:background="@drawable/bg_search_chip_active"
                    android:text="25,624"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Bar (Pill with clean elevation & hint) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_search_input">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_search"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Search Icon" />

            <EditText
                android:id="@+id/et_search_songs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="40dp"
                android:background="@null"
                android:hint="Search songs, movies, singers, raga..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Clear search" />
        </FrameLayout>

        <!-- Active Filter Indicator Bar (e.g. Movie filter) -->
        <LinearLayout
            android:id="@+id/layout_active_filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_active_filter_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="🎬 Showing all songs in: ഭക്ത ഹനുമാന്‍" />

            <TextView
                android:id="@+id/btn_clear_movie_filter"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_search_chip_inactive_light"
                android:text="✕ Clear"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Filter & Sort Chips ScrollView -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:id="@+id/layout_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- All Songs Chip -->
                <TextView
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="All Songs"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_search_chip_active"
                    android:layout_marginEnd="8dp" />

                <!-- Sort Picker Chip -->
                <TextView
                    android:id="@+id/chip_sort_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Sort ▾"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <!-- Year Selector Chip (Pick Any Year 1938-2026) -->
                <TextView
                    android:id="@+id/chip_year_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="📆 Select Year ▾"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <!-- Decade Chips -->
                <TextView
                    android:id="@+id/chip_2020s"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="2020s"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_2010s"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="2010s"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_2000s"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="2000s"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_90s"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="90s Golden Hits"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_80s"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="80s Classics"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_oldies"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Oldies (50s-70s)"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <!-- Singer Chips -->
                <TextView
                    android:id="@+id/chip_yesudas"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="KJ Yesudas"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_chithra"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="KS Chithra"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_janaki"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="S Janaki"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_sujatha"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Sujatha"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_sreekumar"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="MG Sreekumar"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_jayachandran"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="P Jayachandran"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:background="@drawable/bg_search_chip_inactive_light"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Song Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_songs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_header_container"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="84dp" />

    <!-- Initial Loading State -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading 25,000+ Malayalam Songs..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fast indexing database"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- Empty Search State -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_music_note"
            app:tint="?android:attr/textColorSecondary"
            android:alpha="0.4"
            android:contentDescription="No Songs" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No songs found"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Try searching with song name, movie name, or singer"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center" />
    </LinearLayout>

</RelativeLayout>
