<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_add_channel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Top App Bar / Compact Header -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#1E293B">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Channel"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_toolbar_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search YouTube or paste a channel link"
                android:textSize="12sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Optional Subtle Context Badge (e.g. Target: 📺 News) -->
        <TextView
            android:id="@+id/tv_context_category"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_choice_card"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Search Input Box -->
    <LinearLayout
        android:id="@+id/layout_search_input"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_search_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="#94A3B8"
            android:layout_marginEnd="8dp"
            android:contentDescription="Search Icon" />

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search channels or videos..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8"
            android:background="?selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Clear" />

        <TextView
            android:id="@+id/btn_search_action"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Search"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_accent"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Secondary Action: Paste Channel Link -->
    <LinearLayout
        android:id="@+id/btn_paste_channel_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_paste_link_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_paste_link_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste YouTube channel link / ID"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent" />
    </LinearLayout>

    <!-- Filter Chips: All | Channels | Videos -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_search_chip_active"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_channels"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Channels"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/bg_search_chip_inactive_dark"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_videos"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Videos"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/bg_search_chip_inactive_dark"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Top Matched Channel Banner (Compact) -->
    <LinearLayout
        android:id="@+id/layout_channel_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_channel_banner"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_channel_banner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_live_tv"
            android:background="@drawable/bg_circle_dark"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_channel_banner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_channel_banner_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube Channel • Tap to add"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_add_channel_banner"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="+ Add"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_accent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Results / Empty / Loading Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progress_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorAccent"
            android:visibility="gone" />

        <!-- Compact Empty / Initial Search Prompt (~120–140dp) -->
        <LinearLayout
            android:id="@+id/layout_search_empty"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_search_empty_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_search"
                app:tint="#475569"
                android:contentDescription="Search prompt" />

            <TextView
                android:id="@+id/tv_search_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Search YouTube"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0" />

            <TextView
                android:id="@+id/tv_search_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Find channels, creators, movies or videos"
                android:textSize="12sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Search Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
