<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/categoryCardBackground"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Dialog Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort Songs"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select order for 25,600+ Malayalam Songs"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_sort"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="?android:attr/textColorSecondary"
            android:contentDescription="Close" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/squircleCardStroke" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <!-- 1. Year Newest -->
            <RelativeLayout
                android:id="@+id/opt_sort_year_desc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="📅  Year: Newest First (2026 → 1938)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_year_desc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 2. Year Oldest -->
            <RelativeLayout
                android:id="@+id/opt_sort_year_asc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="📅  Year: Oldest First (1938 → 2026)"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_year_asc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 3. Song Name A-Z -->
            <RelativeLayout
                android:id="@+id/opt_sort_song_asc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="🎵  Song Title: A → Z"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_song_asc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 4. Song Name Z-A -->
            <RelativeLayout
                android:id="@+id/opt_sort_song_desc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="🎵  Song Title: Z → A"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_song_desc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 5. Movie Name A-Z -->
            <RelativeLayout
                android:id="@+id/opt_sort_movie_asc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="🎬  Movie Name: A → Z"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_movie_asc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 6. Singer Name A-Z -->
            <RelativeLayout
                android:id="@+id/opt_sort_singer_asc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="🎙️  Singer: A → Z"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_singer_asc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 7. Musician / Composer A-Z -->
            <RelativeLayout
                android:id="@+id/opt_sort_musician_asc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="🎼  Music Director: A → Z"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_musician_asc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- 8. Lyricist A-Z -->
            <RelativeLayout
                android:id="@+id/opt_sort_lyricist_asc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="✍️  Lyricist: A → Z"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ImageView
                    android:id="@+id/check_sort_lyricist_asc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorAccent"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
