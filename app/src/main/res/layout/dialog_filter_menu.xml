<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark"
    android:padding="14dp">

    <!-- Compact Header with Title and Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btn_close_filter">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📰  Filter News &amp; Directory"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Explore newspapers, channels and feeds by state &amp; category"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_filter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:padding="3dp"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- Option 1: YouTube Search (In-App) -->
    <LinearLayout
        android:id="@+id/btn_filter_youtube"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_youtube_brand"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube Inner Search"
                android:textColor="#FF4D4D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search any movie, song, or video on YouTube"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Option 2: Search by Name -->
    <LinearLayout
        android:id="@+id/btn_filter_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="🔍"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search by Name"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actor, Actress, Director, or Movie Title"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Option 3: Actors & Actresses -->
    <LinearLayout
        android:id="@+id/btn_filter_cast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="🎭"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actors &amp; Actresses"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse cast profiles with photos &amp; film counts"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Option 4: Directors -->
    <LinearLayout
        android:id="@+id/btn_filter_director"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="🎬"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Film Directors"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter by acclaimed Malayalam filmmakers"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Option 5: Release Year -->
    <LinearLayout
        android:id="@+id/btn_filter_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="📅"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Release Year"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3-column grid sorted latest first (2026 to 1938)"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Option 6: Genre -->
    <LinearLayout
        android:id="@+id/btn_filter_genre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="🏷️"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie Genre"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Action, Comedy, Drama, Romance, Thriller &amp; more"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Option 7: Reset Filter -->
    <LinearLayout
        android:id="@+id/btn_filter_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_option_card"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="🔄"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset All Filters"
                android:textColor="#E11D48"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show all movies in vault without filters"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#64748B"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
