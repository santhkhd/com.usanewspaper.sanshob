<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_news"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ToolbarPopupTheme"
        app:title=""
        android:elevation="4dp" />

    <!-- Main Content Scroll -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_news"
        android:layout_above="@id/bottom_action_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Headline -->
            <TextView
                android:id="@+id/text_news_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:lineSpacingExtra="4dp"
                android:text="News Headline Title Goes Here" />

            <!-- Meta: Category Badge & Follow Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/text_news_detail_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_outline"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="General News"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_follow_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_outline"
                    android:backgroundTint="@color/color_light_primary"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="+ Follow"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Date -->
            <TextView
                android:id="@+id/text_news_detail_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tue, 01 Sep 2026 23:39:37 +0530"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <!-- News Image -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_image_news_detail"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/image_news_detail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />
            </androidx.cardview.widget.CardView>

            <!-- 🎧 AUDIO NEWS READER (Text-to-Speech Player Bar) -->
            <LinearLayout
                android:id="@+id/card_audio_reader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_audio_player"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/img_tts_speaker"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#1E293B"
                    android:padding="8dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="#38BDF8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTEN TO NEWS"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tv_tts_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap Play for audio briefing"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <!-- Speed Toggle Chip -->
                <TextView
                    android:id="@+id/btn_tts_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="1.0x"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Play / Pause Button -->
                <ImageView
                    android:id="@+id/btn_tts_play"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#0284C7"
                    android:padding="7dp"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Stop Button -->
                <ImageView
                    android:id="@+id/btn_tts_stop"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#334155"
                    android:padding="8dp"
                    android:src="@drawable/ic_stop"
                    app:tint="#CBD5E1"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Description / Body Excerpt -->
            <TextView
                android:id="@+id/text_news_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="6dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:text="News story full summary and description will appear here..." />

            <!-- Prominent CONTINUE READING Button (Matches Screenshot 4) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_continue_reading"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="👁  CONTINUE READING"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="10dp"
                android:backgroundTint="#0284C7" />

            <!-- Like & Dislike Reaction Bar (Matches Screenshot 4) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="18dp">

                <!-- Thumbs Up / Like -->
                <LinearLayout
                    android:id="@+id/btn_news_like"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/img_news_like"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_thumb_up"
                        app:tint="#10B981" />

                    <TextView
                        android:id="@+id/text_news_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Thumbs Down / Dislike -->
                <LinearLayout
                    android:id="@+id/btn_news_dislike"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/img_news_dislike"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_thumb_down"
                        app:tint="#EF4444" />

                    <TextView
                        android:id="@+id/text_news_dislike_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Comments Section Header (Properly Aligned - No Overlap) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reader Comments"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btn_open_add_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Write Comment"
                    android:textColor="@color/colorAccent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_badge_outline"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Comments Container -->
            <LinearLayout
                android:id="@+id/container_news_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Floating Sticky Bar: 'What do you think?' (Matches Screenshot 4) -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 'What do you think?' Comment Trigger -->
        <LinearLayout
            android:id="@+id/bar_write_comment"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_outline"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="What do you think?"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/bar_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Share Button -->
        <ImageView
            android:id="@+id/bar_share_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_share"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?android:attr/textColorPrimary"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</RelativeLayout>
