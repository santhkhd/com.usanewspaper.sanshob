<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_bottom_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"
    android:background="?attr/categoryCardBackground">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Channel to"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tv_sheet_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select destination category"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Shortcut: + New Category button at top -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_new_category_top"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ New"
            android:textColor="@color/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/colorAccent"
            app:iconSize="14dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F888888"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <!-- Current Category Block (Visible if current category is defined) -->
    <LinearLayout
        android:id="@+id/layout_current_category_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current category"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:id="@+id/layout_current_category_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_current_category_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📺 All Malayalam"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <ImageView
                android:id="@+id/img_current_category_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="@color/colorAccent"
                android:contentDescription="Selected" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_other_categories_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other categories"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp" />
    </LinearLayout>

    <!-- Categories List bounded with MaxHeightRecyclerView so buttons never get pushed off screen -->
    <com.app.webdroid.util.MaxHeightRecyclerView
        android:id="@+id/rv_sheet_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="190dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F888888"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Create New Category Button Row -->
    <LinearLayout
        android:id="@+id/btn_sheet_create_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add"
            app:tint="@color/colorAccent"
            android:layout_marginEnd="12dp"
            android:contentDescription="New Category" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="＋ Create New Category"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_back"
            android:rotation="180"
            app:tint="?android:attr/textColorSecondary"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Primary Action: Always-visible Add Channel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sheet_add_confirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:text="Add Channel"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:icon="@drawable/ic_add"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/colorAccent" />

</LinearLayout>
