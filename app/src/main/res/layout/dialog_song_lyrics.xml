<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/categoryCardBackground"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Top Header: Vinyl Icon, Song Title, Movie & Actions -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/layout_vinyl_header"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_vinyl_avatar"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                app:tint="@color/colorAccent"
                android:contentDescription="Music Icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/layout_vinyl_header"
            android:layout_toStartOf="@id/layout_lyrics_actions"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_lyrics_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song Title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_lyrics_movie_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Movie • Year"
                android:textColor="@color/colorAccent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_lyrics_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_copy_lyrics"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_content_copy"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Copy Lyrics" />

            <ImageView
                android:id="@+id/btn_share_lyrics"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Share Song" />

            <ImageView
                android:id="@+id/btn_close_lyrics"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Close" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Quick Action Buttons: Play YouTube, Search YouTube & All Songs in this Movie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lyrics_play_youtube"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Watch Video"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_play_arrow"
                app:iconSize="18dp"
                app:iconTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/colorAccent"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lyrics_search_youtube"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Search YouTube"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                app:icon="@drawable/ic_youtube_brand"
                app:iconSize="16dp"
                app:iconTint="#FF0000"
                app:cornerRadius="20dp"
                app:strokeColor="?attr/squircleCardStroke"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lyrics_movie_songs"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:text="All Songs in this Movie"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            app:icon="@drawable/ic_movie"
            app:iconSize="16dp"
            app:iconTint="?android:attr/textColorSecondary"
            app:cornerRadius="19dp"
            app:strokeColor="?attr/squircleCardStroke" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/squircleCardStroke" />

    <!-- Scrollable Content: Metadata Grid + Lyrics -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp">

            <!-- Song Info Card (Metadata) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/squircleCardStroke"
                app:cardBackgroundColor="?attr/squircleCardBackground"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Singers -->
                    <LinearLayout
                        android:id="@+id/row_lyrics_singers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="86dp"
                            android:layout_height="wrap_content"
                            android:text="🎙️ പാടിയവർ:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_lyrics_artists"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Singers"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <!-- Musician -->
                    <LinearLayout
                        android:id="@+id/row_lyrics_musician"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="86dp"
                            android:layout_height="wrap_content"
                            android:text="🎼 സംഗീതം:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_lyrics_musician"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Music Director"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <!-- Lyricist -->
                    <LinearLayout
                        android:id="@+id/row_lyrics_lyricist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="86dp"
                            android:layout_height="wrap_content"
                            android:text="✍️ രചന:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_lyrics_lyricist"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lyricist"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <!-- Raga (if available) -->
                    <LinearLayout
                        android:id="@+id/row_lyrics_raga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="86dp"
                            android:layout_height="wrap_content"
                            android:text="🎵 രാഗം:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_lyrics_raga"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Raga"
                            android:textSize="13sp"
                            android:textColor="@color/color_gold" />
                    </LinearLayout>

                    <!-- Actors (if available) -->
                    <LinearLayout
                        android:id="@+id/row_lyrics_actors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="86dp"
                            android:layout_height="wrap_content"
                            android:text="🎭 അഭിനേതാക്കൾ:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_lyrics_actors"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Actors"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lyrics Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 ഗാന വരികൾ (Lyrics)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Lyrics Content -->
            <TextView
                android:id="@+id/tv_lyrics_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="7dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textIsSelectable="true"
                tools:text="ചരിത്രനായകാ ജയിക്ക നീ\nചതുരംഗ സേനാനായകാ..." />

            <!-- No Lyrics fallback card -->
            <LinearLayout
                android:id="@+id/layout_no_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="?android:attr/textColorSecondary"
                    android:alpha="0.4"
                    android:contentDescription="No lyrics" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ഗാന വരികൾ ഉടൻ ലഭ്യമാകും"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Full lyrics not yet archived. You can play and enjoy the song on YouTube above."
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
