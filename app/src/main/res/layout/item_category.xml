<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="5dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Compact Squircle Card Container (PhonePe Light Style Reference) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:clickable="false"
        android:focusable="false"
        app:cardBackgroundColor="?attr/squircleCardBackground"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/squircleCardStroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Channel / Category Icon (Proportionately scaled, clean light padding) -->
            <ImageView
                android:id="@+id/image_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <!-- Unread Badge (Top-Left Corner) -->
            <TextView
                android:id="@+id/text_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Favorite Button (Top-Right, Dedicated Touch Target) -->
            <ImageView
                android:id="@+id/img_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Favorite"
                android:padding="5dp"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/color_light_primary" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Row: Title + 3-Dot Options Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Short Title (2 Lines Fixed Height for Grid Uniformity) -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="11sp" />

        <!-- 3-Dot Options Button (Comfortable 32dp Touch Target) -->
        <ImageView
            android:id="@+id/btn_card_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            android:padding="5dp"
            android:src="@drawable/ic_more_vert"
            app:tint="?android:attr/textColorSecondary" />

    </LinearLayout>

</LinearLayout>
