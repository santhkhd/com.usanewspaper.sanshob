<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A10"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="460dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:background="#070A10"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/color_dark_toolbar"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            android:fitsSystemWindows="true">

            <ImageView
                android:id="@+id/image_movie_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                android:fitsSystemWindows="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/gradient_shadow"
                android:layout_gravity="bottom" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="110dp"
            android:clipToPadding="false">

            <!-- Movie Title -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />

            <!-- Badges Row: Year, Runtime, Rating, Genre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/text_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024"
                    android:textColor="#E2E8F0"
                    android:background="@drawable/bg_badge_outline"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_runtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120 min"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="10dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.5 ★"
                    android:textColor="@color/color_gold"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_outline"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="10dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_genre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Action, Drama, Thriller"
                android:textColor="#94A3B8"
                android:layout_marginTop="10dp"
                android:textSize="13sp" />

            <!-- Action Buttons: Watch Full Movie, Trailer, Songs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <Button
                    android:id="@+id/btn_watch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="▶  WATCH FULL MOVIE (OTT / WEB)"
                    android:backgroundTint="@color/color_light_primary"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="4dp" />

                <Button
                    android:id="@+id/btn_direct_watch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:text="⚡  DIRECT PLAY (IN-APP STREAM)"
                    android:backgroundTint="#059669"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="4dp" />

                <Button
                    android:id="@+id/btn_check_ott"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:layout_marginTop="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🌐  CHECK ALL OTT PLATFORMS\n(HOTSTAR, PRIME, SONYLIV...)"
                    android:backgroundTint="#4F46E5"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textStyle="bold"
                    android:elevation="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_trailer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="🎬 TRAILER"
                        android:backgroundTint="#1E293B"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_songs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="🎵 SONGS"
                        android:backgroundTint="#1E293B"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_remind_me"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="🔔  REMIND ME ON RELEASE DAY"
                    android:backgroundTint="#1E293B"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Disclaimer Card -->
                <LinearLayout
                    android:id="@+id/card_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_disclaimer_card"
                    android:padding="12dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Disclaimer: Movie streams and video links are automatically sourced from YouTube &amp; public archives. While we aim for high accuracy, some links may occasionally show promotional clips, trailers, or third-party re-uploads instead of the full movie."
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Plot Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Synopsis"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/text_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Story synopsis..."
                android:textColor="#94A3B8"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:textSize="14sp" />

            <!-- Cast Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starring Cast  🌐 Tap for Wikipedia"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/text_cast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cast members..."
                android:textColor="#60A5FA"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Director Section -->
            <TextView
                android:id="@+id/lbl_director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Director  🌐 Tap for Wikipedia"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/text_director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Director name..."
                android:textColor="#60A5FA"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
