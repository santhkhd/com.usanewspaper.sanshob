<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="BaseTheme" />

    <style name="AppDarkTheme" parent="BaseDarkTheme" />

    <style name="BaseTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_light_primary</item>
        <item name="colorPrimaryDark">@color/color_light_status_bar</item>
        <item name="colorAccent">@color/color_light_accent</item>
        <item name="android:windowBackground">@color/color_light_background</item>
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorOnSurface">@color/color_light_primary</item>
        <item name="colorSecondaryContainer">@color/color_selected_item</item>
        <item name="colorOnSecondaryContainer">@color/color_light_primary</item>
        <item name="android:textColorPrimary">@color/color_light_text_primary</item>
        <item name="android:textColorSecondary">@color/color_light_text_secondary</item>
        <item name="materialAlertDialogTheme">@style/Material3AlertDialogDefault</item>
        <item name="popupMenuBackground">@drawable/bg_popup_default</item>
        <item name="android:popupElevation">3dp</item>
        <item name="categoryCardBackground">@color/color_white</item>
        <item name="categoryCardTextColor">@color/color_light_text_primary</item>
        <item name="squircleCardBackground">@color/color_squircle_card_bg_light</item>
        <item name="squircleCardStroke">@color/color_squircle_card_stroke_light</item>
    </style>

    <style name="BaseDarkTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/color_light_primary</item>
        <item name="colorPrimaryDark">@color/color_dark_status_bar</item>
        <item name="colorAccent">@color/color_dark_accent</item>
        <item name="android:windowBackground">@color/color_dark_background</item>
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorOnSurface">@color/color_white</item>
        <item name="colorSecondaryContainer">@color/color_selected_item</item>
        <item name="colorOnSecondaryContainer">@color/color_white</item>
        <item name="android:textColorPrimary">@color/color_dark_text_primary</item>
        <item name="android:textColorSecondary">@color/color_dark_text_secondary</item>
        <item name="materialAlertDialogTheme">@style/Material3AlertDialogDark</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="popupMenuBackground">@drawable/bg_popup_dark</item>
        <item name="android:popupElevation">3dp</item>
        <item name="categoryCardBackground">@color/color_card_dark</item>
        <item name="categoryCardTextColor">@color/color_white</item>
        <item name="squircleCardBackground">@color/color_squircle_card_bg_dark</item>
        <item name="squircleCardStroke">@color/color_squircle_card_stroke_dark</item>
    </style>

    <style name="Material3AlertDialogDefault" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/color_light_background</item>
        <item name="backgroundTint">@color/color_light_background</item>
        <item name="colorSurface">@color/color_light_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button</item>
    </style>

    <style name="Material3AlertDialogDark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/color_dark_dialog</item>
        <item name="backgroundTint">@color/color_dark_dialog</item>
        <item name="colorSurface">@color/color_dark_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="colorPrimary">@color/color_light_primary</item>
        <item name="android:textColor">@color/color_light_primary</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/color_white</item>
    </style>

    <style name="Widget.App.RadioFilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/color_radio_chip_bg</item>
        <item name="android:textColor">@color/color_radio_chip_text</item>
        <item name="chipStrokeColor">@color/color_radio_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="checkedIconTint">@color/color_radio_chip_icon</item>
        <item name="checkedIconVisible">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/color_ripple_white</item>
    </style>

    <style name="Widget.App.NewsFilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/color_news_chip_bg</item>
        <item name="android:textColor">@color/color_news_chip_text</item>
        <item name="chipStrokeColor">@color/color_news_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ToolbarFontStyle" parent="@style/Base.TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/custom_font</item>
    </style>

    <style name="MaterialButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/corner_radius_large</item>
        <item name="backgroundTint">@color/color_light_primary</item>
        <item name="android:textColor">@color/color_white</item>
    </style>

    <style name="ShapeAppearance.Image.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius</item>
    </style>

    <style name="CustomCardViewStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Card.Custom.Corners</item>
    </style>


    <style name="ShapeAppearanceOverlay.Card.Custom.Corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">30dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomRight">30dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>


    <style name="ToolbarPopupTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/color_black</item>
        <item name="android:textColorSecondary">@color/color_black</item>
        <item name="android:textColor">@color/color_black</item>
        <item name="android:background">@color/color_white</item>
        <item name="android:colorBackground">@color/color_white</item>
        <item name="popupMenuBackground">@android:color/white</item>
    </style>

    <style name="FullScreenCategoryDialogTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="ShapeAppearance.VideoPlayer" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

</resources>
